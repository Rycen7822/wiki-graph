# Copy to .env, set owner-only permissions (chmod 600 .env), and edit the paths below.
# This file is tracked; NEVER put real credentials, private hosts, or personal paths here.
# The project env reader does not expand ${VARS}; use full absolute paths
# (not ~ for portability), one KEY=VALUE per line, and keep optional settings commented until configured.
# Keep the wiki, native state, and temporary work directories separate.

# Required for .agents/skills/llm-wiki/scripts/load_env_paths.py --check
WIKI_GRAPH_REPO=/absolute/path/to/wiki-graph
LLM_WIKI_ROOT=/absolute/path/to/your/wiki
LLM_WIKI_STATE_DIR=/absolute/path/to/native-state
LLM_WIKI_STORAGE_ROOT=/absolute/path/to/storage
LLM_WIKI_RAW_FAST_TMP_ROOT=/absolute/path/to/raw-fast-scratch
LLM_WIKI_RAW_FAST_BATCH_TMP_ROOT=/absolute/path/to/raw-fast-batches

# Optional browser/OpenReview paths (absolute; keep the OpenReview credential
# file outside this checkout and point OPENREVIEW_ENV_PATH to it).
# LLM_WIKI_OBCLIP_WRAPPER=/absolute/path/to/chromium-wrapper
# LLM_WIKI_OBCLIP_PROFILE=/absolute/path/to/dedicated-browser-profile
# OPENREVIEW_ENV_PATH=/absolute/path/to/openreview.env

# Native API: defaults to 127.0.0.1:9621. If changing the port, update both
# LLM_WIKI_SERVER and LLM_WIKI_NATIVE_HEALTH_URL to match. Keep secrets in .env.
# LLM_WIKI_NATIVE_HOST=127.0.0.1
# LLM_WIKI_NATIVE_PORT=9621
# LLM_WIKI_SERVER=http://127.0.0.1:9621
# LLM_WIKI_NATIVE_HEALTH_URL=http://127.0.0.1:9621/health
# LLM_WIKI_NATIVE_API_KEY=
# LLM_WIKI_NATIVE_WORKSPACE_FILE=/absolute/path/to/native-state/native_zvec/active_workspace.json
# LLM_WIKI_NATIVE_SERVER_LOG_DIR=/absolute/path/to/native-state/native_zvec/server_logs
# LLM_WIKI_NATIVE_SERVER_PIDFILE=/absolute/path/to/native-state/native_zvec/native_server_9621.pid

# Embedding provider for native queries and refresh. Set a real compatible
# endpoint, model, dimension, and API key in your private .env before using it.
# EMBEDDING_BINDING_HOST=https://your-provider.example/v1
# EMBEDDING_BINDING_API_KEY=
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_DIM=1024
# EMBEDDING_TIMEOUT=60
# EMBEDDING_PARAMS_VERSION=v1
# Optional transport flags must match your model/service; changing the embedding
# contract may require a guarded refresh and should not be copied blindly.
# EMBEDDING_SEND_DIM=false
# EMBEDDING_USE_BASE64=false
# EMBEDDING_ASYMMETRIC=false
# EMBEDDING_TOKEN_LIMIT=32768
# EMBEDDING_TRUNCATION_SIDE=right
# LLM_WIKI_NATIVE_EMBEDDING_PROFILE=conservative

# Optional: manage a local embedding service during native refresh. Leave off
# unless Docker Compose, its service, and the health endpoint are configured.
LLM_WIKI_NATIVE_LOCAL_EMBEDDING_DOCKER_MANAGED=false
# LLM_WIKI_NATIVE_LOCAL_EMBEDDING_COMPOSE_DIR=/absolute/path/to/compose-project
# LLM_WIKI_NATIVE_LOCAL_EMBEDDING_COMPOSE_SERVICE=api
# LLM_WIKI_NATIVE_LOCAL_EMBEDDING_HEALTH_URL=http://127.0.0.1:8000/health
# LLM_WIKI_NATIVE_LOCAL_EMBEDDING_START_TIMEOUT=1800
# LLM_WIKI_NATIVE_LOCAL_EMBEDDING_HEALTH_INTERVAL=2
# LLM_WIKI_NATIVE_LOCAL_EMBEDDING_STOP_TIMEOUT=180

# Optional native answer generation (independent of embedding configuration).
# LLM_WIKI_NATIVE_ANSWER_BASE_URL=https://your-provider.example/v1
# LLM_WIKI_NATIVE_ANSWER_MODEL=your-answer-model
# LLM_WIKI_NATIVE_ANSWER_API_KEY=
# LLM_WIKI_NATIVE_ANSWER_TIMEOUT_SECONDS=120
